    },
    {
      "name": "11b7422f",
      "displayName": "Top 10 Products By Revenue",
      "queryLines": [
        "SELECT\r\n",
        "    sku,\r\n",
        "    category_name,\r\n",
        "    ROUND(SUM(gross_amount_php), 2) AS gross_revenue_php,\r\n",
        "    SUM(quantity) AS total_units,\r\n",
        "    ROUND(AVG(unit_price), 2) AS avg_unit_price\r\n",
        "FROM ecommerce.gold.fact_transactions_denorm\r\n",
        "GROUP BY sku, category_name\r\n",
        "ORDER BY gross_revenue_php DESC\r\n",
        "LIMIT 10"
      ]
    }
  ],
